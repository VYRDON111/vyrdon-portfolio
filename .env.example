# --- Cloudflare Worker / API (not yet deployed) ---
# Zoho CRM sync (used by worker/api/lead.js after 3 approvals)
ZOHO_CLIENT_ID=your-id-here
ZOHO_CLIENT_SECRET=your-secret-here
ZOHO_REFRESH_TOKEN=your-refresh-token-here
ZOHO_CRM_BASE_URL=https://www.zohoapis.com

# --- Social connector (draft-only, not built) ---
# X / Twitter API v2 — draft creation only; posting gated by SOCIAL_POSTING_APPROVED
X_API_KEY=your-key-here
X_API_SECRET=your-secret-here
X_ACCESS_TOKEN=your-token-here
X_ACCESS_SECRET=your-secret-here
SOCIAL_POSTING_APPROVED=false
SOCIAL_APPROVER_SIGNATURE=your-signed-approval-here
SOCIAL_DRAFT_STORE_URL=your-store-url-here

# --- Local dev server ---
PORT=5173